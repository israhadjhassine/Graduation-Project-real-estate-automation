@startuml
autonumber

actor ":SubAgent" as SubAgent
boundary ":VisitManagementPage" as VisitManagementPage
control ":VisitsController" as VisitsController
boundary ":GoogleCalendar" as GoogleCalendar
entity ":visitModel" as visitModel

SubAgent -> VisitManagementPage : clickSyncGoogleCalendar()
activate VisitManagementPage

VisitManagementPage -> VisitsController : sync_visits_with_google_calendar(agent_id)
activate VisitsController

VisitsController -> GoogleCalendar : fetch_agent_events(agent_id)
activate GoogleCalendar
GoogleCalendar --> VisitsController : returns(events_list)
deactivate GoogleCalendar

VisitsController -> visitModel : bulk_update_visits(events_list)
activate visitModel
visitModel --> VisitsController : returns_true()
deactivate visitModel

VisitsController --> VisitManagementPage : returns_true()
deactivate VisitsController

VisitManagementPage -> VisitManagementPage : renderVisits()
deactivate VisitManagementPage
@enduml
