@startuml
autonumber

actor ":SubAgent" as SubAgent
boundary ":VisitManagementPage" as VisitManagementPage
control ":VisitsController" as VisitsController
entity ":visitModel" as visitModel

SubAgent -> VisitManagementPage : filterVisits(status, date_range)
activate VisitManagementPage

VisitManagementPage -> VisitsController : get_filtered_visits(agent_id, status, date_range)
activate VisitsController

VisitsController -> visitModel : find_by_filters(agent_id, status, date_range)
activate visitModel
visitModel --> VisitsController : returns(filtered_visits)
deactivate visitModel

VisitsController --> VisitManagementPage : returns(filtered_visits)
deactivate VisitsController

VisitManagementPage -> VisitManagementPage : renderVisits()
deactivate VisitManagementPage
@enduml
