@startuml
autonumber

actor ":SubAgent" as SubAgent
boundary ":CalendarTab" as CalendarTab
control ":VisitsController" as VisitsController
entity ":visitModel" as visitModel

SubAgent -> CalendarTab : openCalendarTab()
activate CalendarTab

CalendarTab -> VisitsController : get_agent_visits_list(agent_id)
activate VisitsController

VisitsController -> visitModel : find_by_agent_id(agent_id)
activate visitModel
visitModel --> VisitsController : returns(visits_list)
deactivate visitModel

VisitsController --> CalendarTab : returns(visits_list)
deactivate VisitsController

CalendarTab -> CalendarTab : renderCalendar(visits_list)

CalendarTab -> CalendarTab : renderVisitsForSelectedDate()


SubAgent -> CalendarTab : selectDate(day, month, year)
CalendarTab -> CalendarTab : filter_visits(day, month, year)
CalendarTab -> CalendarTab : renderFilteredVisits()
deactivate CalendarTab
@enduml
