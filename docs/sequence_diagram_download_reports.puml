@startuml

actor ":Admin" as Admin
boundary ":ReportsPage" as ReportsPage
control ":ReportController" as ReportController
entity ":reportModel" as reportModel
control ":reportService" as reportService

ref over Admin, ReportsPage, ReportController: Authenticate

Admin -> ReportsPage : loadPage()
activate ReportsPage

ReportsPage -> ReportController : list_reports()
activate ReportController

ReportController -> reportModel : get_all_reports()
activate reportModel
reportModel --> ReportController : return (reports_list)

ReportController --> ReportsPage : return (reports_list)

ReportsPage -> ReportsPage : renderReports(reports_list)

Admin -> ReportsPage : downloadReport(report_id)

ReportsPage -> ReportController : download_report(report_id)

ReportController -> reportModel : get_by_id(report_id)
reportModel --> ReportController : return (report)
deactivate reportModel

ReportController -> reportService : generate_transaction_report(report)
activate reportService
reportService --> ReportController : return (pdf_file)
deactivate reportService

ReportController --> ReportsPage : return (pdf_file)
deactivate ReportController

ReportsPage -> ReportsPage : triggerFileDownload(pdf_file)
deactivate ReportsPage

@enduml
