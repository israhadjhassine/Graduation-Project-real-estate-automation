@startuml

actor ":SubAgent" as SubAgent
boundary ":AnalyticsPage" as AnalyticsPage
control ":StatisticsController" as StatisticsController
entity ":AnalyticsRepository" as AnalyticsRepository

ref over SubAgent, AnalyticsPage, StatisticsController: Authenticate

SubAgent -> AnalyticsPage : loadPage()
activate AnalyticsPage

AnalyticsPage -> StatisticsController : get_agent_statistics(agent_id)
activate StatisticsController

StatisticsController -> AnalyticsRepository : get_property_status_counts(agent_id)
activate AnalyticsRepository
AnalyticsRepository --> StatisticsController : return (property_statuses)
deactivate AnalyticsRepository

StatisticsController -> AnalyticsRepository : get_visit_status_counts(agent_id)
activate AnalyticsRepository
AnalyticsRepository --> StatisticsController : return (visit_statuses)
deactivate AnalyticsRepository

StatisticsController -> AnalyticsRepository : get_visits_history(agent_id, start_date)
activate AnalyticsRepository
AnalyticsRepository --> StatisticsController : return (visits_history)
deactivate AnalyticsRepository

StatisticsController --> AnalyticsPage : return (statistics_data)
deactivate StatisticsController

AnalyticsPage -> AnalyticsPage : renderAnalytics(statistics_data)
deactivate AnalyticsPage

@enduml
