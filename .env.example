# 1. Database Credentials
POSTGRES_USER=real_estate_user
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=real_estate_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# 2. n8n Credentials
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=secure_password_here
WEBHOOK_URL=https://your-subdomain.ngrok-free.app
N8N_HOST=your-subdomain.ngrok-free.app
N8N_EDITOR_BASE_URL=https://your-subdomain.ngrok-free.app
NGROK_AUTHTOKEN=your_ngrok_auth_token_here
N8N_USER_DATA_PATH=./data/n8n
N8N_ENCRYPTION_KEY=secure_n8n_encryption_key_here

# 3. AI Integrations (OpenRouter API)
# API key for OpenRouter to invoke DeepSeek-V4-Flash inside n8n
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 4. Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 5. Security & JWT
JWT_SECRET_KEY=your_jwt_secret_key_here

# 6. ImageKit CDN Credentials (for property images)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint_id

# 7. Email Configuration (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=your_email@gmail.com