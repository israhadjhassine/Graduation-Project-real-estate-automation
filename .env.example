# 1. Database Credentials
POSTGRES_USER=real_estate_user
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=real_estate_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# 2. n8n Credentials
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
# WEBHOOK_TUNNEL_URL: The public URL for n8n webhooks (needed for Telegram). 
# You can use tools like "localtunnel" or "ngrok" to get one for local dev.
WEBHOOK_URL=
N8N_HOST=
N8N_EDITOR_BASE_URL=
NGROK_AUTHTOKEN=
# Path to your n8n data (useful for migrating existing accounts)
# Partner should use: ./data/n8n
# You should use: C:/Users/jesse/.n8n 
N8N_USER_DATA_PATH=./data/n8n

# 3. Google Gemini API Key
# Replace OpenAI with Gemini for AI-driven features
GEMINI_API_KEY=

# 4. Telegram Bot Token
TELEGRAM_BOT_TOKEN=8593567105:AAHmBoDlsjgZFEIihEhSNvrfpcTC1pBB6Gg

# 5. Google OAuth 2.0 Credentials (for Calendar Sync)
# Instead of Service Accounts, we use OAuth2 for user-level access
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# 6. Security
JWT_SECRET_KEY=yoursecretkeyhere